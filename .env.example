# Server port (default: 9002)
# PORT=9002

# Bind addresses — comma-separated (default: 127.0.0.1)
# Use 0.0.0.0 for all interfaces, or specify multiple: 127.0.0.1,192.168.1.5
# HOST=127.0.0.1

# Base directory for database and files
# (default: $XDG_DATA_HOME/__APP_NAME__ or ~/.local/share/__APP_NAME__)
# DATA_DIR=

# SQLite database path (default: DATA_DIR/__APP_NAME__.db)
# DB_PATH=

# Enable dev mode (Vite proxy). Set automatically by `make dev`.
# DEV=1

# Vite dev server URL. Set automatically by `make dev`.
# VITE_URL=http://127.0.0.1:9005

# AI agent command to run in the web terminal (e.g., claude, aider, goose)
# AGENT_CMD=claude

# Working directory for the agent process (default: current directory)
# WORK_DIR=
